@page
@model IndexModel
@{
    ViewData["Title"] = "PC 목록";
    ViewData["PendingCount"] = Model.PendingRequestCount;
}

<h1>PC 목록</h1>
<p class="subtitle">
    전체 @Model.Devices.Count 대 ·
    연결됨 @Model.Devices.Count(d => d.Online) 대 ·
    연결 끊김 @Model.Devices.Count(d => !d.Online) 대
</p>

@if (Model.WaitingApprovalCount > 0)
{
    <div class="alert info">
        <strong>@Model.WaitingApprovalCount 대</strong>의 새 PC 가 승인을 기다리고 있습니다.
        <a asp-page="/Pending">지금 승인하기</a>
    </div>
}

@if (Model.BypassableCount > 0)
{
    <div class="alert error">
        <strong>@Model.BypassableCount 대</strong>의 PC 에서 직원이 <strong>관리자 권한</strong>으로 로그인하고 있습니다.
        이 PC 들은 서비스를 멈춰 시간 제한을 무력화할 수 있습니다.
        <br />
        해당 계정을 일반 사용자로 낮춰 주세요.
        방법은 배포 폴더의 <code>직원계정_권한낮추기.md</code> 에 정리되어 있습니다.
    </div>
}

@if (Model.RecentSecurityCount > 0)
{
    <div class="alert error">
        최근 하루 동안 <strong>보안 관련 기록이 @Model.RecentSecurityCount 건</strong> 있습니다.
        허용 시간이 아닌데 원격으로 들어오려 한 시도일 수 있습니다.
        <a asp-page="/Events" asp-route-category="보안">확인하기</a>
    </div>
}

@if (Model.PendingRequestCount > 0)
{
    <div class="alert info">
        처리를 기다리는 연장 요청이 <strong>@Model.PendingRequestCount 건</strong> 있습니다.
        <a asp-page="/Requests">지금 처리하기</a>
    </div>
}

@if (Model.Devices.Count == 0)
{
    <div class="panel empty">
        <p>아직 등록된 PC 가 없습니다.</p>
        <p class="muted">
            직원 PC 에서 설치 프로그램을 실행하면 몇 초 안에
            <a asp-page="/Pending">새 PC 승인</a> 화면에 나타납니다.<br />
            거기서 승인하면 이 목록에 들어옵니다.
        </p>
    </div>
}
else
{
    <table>
        <thead>
        <tr>
            <th>PC 이름</th>
            <th>사용자</th>
            <th>상태</th>
            <th>시간표</th>
            <th class="hide-narrow">마지막 연결</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Devices)
        {
            var status = item.Status;
            <tr>
                <td>
                    <a asp-page="/Device" asp-route-id="@item.Id">@item.Name</a>
                    @if (item.Name != item.Device.MachineName)
                    {
                        <div class="muted">@item.Device.MachineName</div>
                    }
                </td>
                <td>@(string.IsNullOrWhiteSpace(item.Device.LastUser) ? "-" : item.Device.LastUser)</td>
                <td>
                    <span class="state @status.Css">@status.Label</span>
                    @if (item.PendingRequests > 0)
                    {
                        <span class="state pending">요청 @item.PendingRequests</span>
                    }
                    @if (item.UserCanBypass)
                    {
                        <span class="state blocked" title="이 계정은 서비스를 멈춰 제한을 피할 수 있습니다">관리자 권한</span>
                    }
                </td>
                <td>@item.PolicyText</td>
                <td class="hide-narrow">@item.LastSeenText</td>
                <td>
                    <a class="button secondary small" asp-page="/Device" asp-route-id="@item.Id">설정</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="hint">
        <strong>연결 끊김</strong> 은 해당 PC 가 @Model.OfflineAfterMinutes 분 넘게 서버에 연락하지 않았다는 뜻입니다.
        PC 가 꺼져 있거나, 랜선이 빠졌거나, 누군가 서비스를 멈췄을 수 있습니다.
        이 경우에도 직원 PC 는 <strong>마지막으로 받은 시간표를 그대로 적용</strong>합니다.
    </div>
}
