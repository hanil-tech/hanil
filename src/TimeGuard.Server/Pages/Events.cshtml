@page
@model EventsModel
@{
    ViewData["Title"] = "기록";
    ViewData["PendingCount"] = Model.PendingRequestCount;
}

<h1>기록</h1>
<p class="subtitle">모든 PC 에서 올라온 기록입니다. 언제 어느 PC 가 꺼졌는지, 원격으로 들어오려 한 시도가 있었는지 확인할 수 있습니다.</p>

@if (Model.SecurityCount > 0 && Model.Category != "보안")
{
    <div class="alert error">
        원격 접속 시도 등 <strong>보안 관련 기록이 @Model.SecurityCount 건</strong> 있습니다.
        <a asp-page="/Events" asp-route-category="보안">보안 기록만 보기</a>
    </div>
}

<div class="panel">
    <form method="get" class="row" style="align-items:flex-end">
        <div class="field">
            <label for="deviceId">PC</label>
            <select id="deviceId" name="deviceId">
                <option value="">전체</option>
                @foreach (var device in Model.DeviceOptions)
                {
                    <option value="@device.Id" selected="@(Model.DeviceId == device.Id)">@device.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="category">구분</label>
            <select id="category" name="category">
                <option value="">전체</option>
                @foreach (var option in Model.CategoryOptions)
                {
                    <option value="@option" selected="@(Model.Category == option)">@option</option>
                }
            </select>
        </div>
        <div class="field" style="flex:0 0 auto">
            <button type="submit" class="secondary">조회</button>
        </div>
    </form>
</div>

@if (Model.Events.Count == 0)
{
    <div class="panel empty"><p class="muted">기록이 없습니다.</p></div>
}
else
{
    <table>
        <thead>
        <tr>
            <th style="width:160px">시각</th>
            <th style="width:180px">PC</th>
            <th style="width:80px">구분</th>
            <th>내용</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Events)
        {
            <tr>
                <td class="muted">@entry.At.Local("yyyy-MM-dd HH:mm:ss")</td>
                <td>@entry.DeviceName</td>
                <td>
                    @if (entry.Category == "보안")
                    {
                        <span class="state blocked">보안</span>
                    }
                    else
                    {
                        @entry.Category
                    }
                </td>
                <td>@entry.Message</td>
            </tr>
        }
        </tbody>
    </table>

    <p class="muted" style="margin-top:12px">최근 @Model.Events.Count 건을 보여 줍니다.</p>
}
